# Memory-harness
# Copy to .env in your working directory. Blank values use built-in defaults.

# Server host. Default: 127.0.0.1.
MEMORY_HARNESS_SERVER__HOST=

# Server port. Default: 8080.
MEMORY_HARNESS_SERVER__PORT=

# Server cors origins. Default: [].
MEMORY_HARNESS_SERVER__CORS_ORIGINS=

# Db path. Default: .state/harness.db.
MEMORY_HARNESS_DB__PATH=

# Db blob dir. Default: .state/blobs.
MEMORY_HARNESS_DB__BLOB_DIR=

# Db busy timeout ms. Default: 5000.
MEMORY_HARNESS_DB__BUSY_TIMEOUT_MS=

# Db inline body max bytes. Default: 4096.
MEMORY_HARNESS_DB__INLINE_BODY_MAX_BYTES=

# Embeddings base url. Set this to enable the integration.
MEMORY_HARNESS_EMBEDDINGS__BASE_URL=

# Embeddings api key. Set this to enable the integration.
MEMORY_HARNESS_EMBEDDINGS__API_KEY=

# Embeddings timeout s. Default: 30.0.
MEMORY_HARNESS_EMBEDDINGS__TIMEOUT_S=

# Embeddings dim. Default: 1024.
MEMORY_HARNESS_EMBEDDINGS__DIM=

# Embeddings max batch. Default: 128.
MEMORY_HARNESS_EMBEDDINGS__MAX_BATCH=

# Llm base url. Set this to enable the integration.
MEMORY_HARNESS_LLM__BASE_URL=

# Llm model. Set this to enable the integration.
MEMORY_HARNESS_LLM__MODEL=

# Llm api key. Set this to enable the integration.
MEMORY_HARNESS_LLM__API_KEY=

# Llm max tokens. Default: 8192.
MEMORY_HARNESS_LLM__MAX_TOKENS=

# Llm timeout s. Default: 180.0.
MEMORY_HARNESS_LLM__TIMEOUT_S=

# Recall Weights relevance. Default: 2.0.
MEMORY_HARNESS_RECALL__WEIGHTS__RELEVANCE=

# Recall Weights freshness. Default: 0.3.
MEMORY_HARNESS_RECALL__WEIGHTS__FRESHNESS=

# Recall Weights confidence. Default: 0.4.
MEMORY_HARNESS_RECALL__WEIGHTS__CONFIDENCE=

# Recall Weights source trust. Default: 0.3.
MEMORY_HARNESS_RECALL__WEIGHTS__SOURCE_TRUST=

# Recall Weights vector leg. Default: 0.5.
MEMORY_HARNESS_RECALL__WEIGHTS__VECTOR_LEG=

# Recall default token budget. Default: 8000.
MEMORY_HARNESS_RECALL__DEFAULT_TOKEN_BUDGET=

# Recall max preferences. Default: 12.
MEMORY_HARNESS_RECALL__MAX_PREFERENCES=

# Recall max facts. Default: 20.
MEMORY_HARNESS_RECALL__MAX_FACTS=

# Recall max episodes. Default: 6.
MEMORY_HARNESS_RECALL__MAX_EPISODES=

# Recall fact budget floor. Default: 0.5.
MEMORY_HARNESS_RECALL__FACT_BUDGET_FLOOR=

# Recall knn k. Default: 200.
MEMORY_HARNESS_RECALL__KNN_K=

# Recall max procedures. Default: 1.
MEMORY_HARNESS_RECALL__MAX_PROCEDURES=

# Recall staleness penalty. Default: 0.1.
MEMORY_HARNESS_RECALL__STALENESS_PENALTY=

# Recall dispute penalty. Default: 0.3.
MEMORY_HARNESS_RECALL__DISPUTE_PENALTY=

# Secrets mode default. Default: store-but-dont-train.
MEMORY_HARNESS_SECRETS__MODE_DEFAULT=

# Secrets entropy threshold. Default: 4.5.
MEMORY_HARNESS_SECRETS__ENTROPY_THRESHOLD=

# Core shared budget tokens. Default: 800.
MEMORY_HARNESS_CORE__SHARED_BUDGET_TOKENS=

# Core agent budget tokens. Default: 800.
MEMORY_HARNESS_CORE__AGENT_BUDGET_TOKENS=

# Graph expand hops. Default: 2.
MEMORY_HARNESS_GRAPH__EXPAND_HOPS=

# Graph hop decay. Default: 0.5.
MEMORY_HARNESS_GRAPH__HOP_DECAY=

# Graph explore max depth. Default: 5.
MEMORY_HARNESS_GRAPH__EXPLORE_MAX_DEPTH=

# Optional path to backend TOML overrides.
MEMORY_HARNESS_CONFIG=

# Local HTTP address of the memory API for adapters.
HARNESS_BASE=

# Harness credential minted for the ingestion service.
INGEST_HARNESS_KEY=

# Harness credential minted for the MCP adapter.
MCP_HARNESS_KEY=

# Harness credential minted for the curator.
CURATOR_API_KEY=

# Comma-separated principal@node values expected by the private-authority audit.
PRIVATE_AUTHORITY_HOLDERS=

# Inbound bearer token for MCP clients.
MCP_ACCESS_TOKEN=

# Comma-separated client:token entries for individually revocable MCP credentials.
MCP_CLIENT_TOKENS=

# Inbound hostnames including ports. Defaults to loopback.
MCP_ALLOWED_HOSTS=

# MCP bind address. Defaults to loopback.
MCP_HOST=

# MCP listener port.
MCP_PORT=

# Local ingestion service URL used by MCP.
INGEST_BASE=

# Ingest bind address. Defaults to loopback.
INGEST_HOST=

# Ingest listener port.
INGEST_PORT=

# Local ingestion ledger database.
INGEST_STATE_DB=

# Scope for imported reference material.
ARTIFACT_SCOPE=

# OCR service base URL.
OCR_BASE=

# OCR service credential.
OCR_KEY=

# Ingest summarizer endpoint.
LLM_BASE=

# Ingest summarizer model ID.
LLM_MODEL=

# Ingest summarizer credential.
LLM_KEY=

# Ingest embedding endpoint.
EMBED_BASE=

# Ingest embedding credential.
EMBED_KEY=

# Comma-separated owners or repositories explicitly enabled for import.
GIT_ALLOWLIST=

# Set to 1 to publish generated indexes to explicitly imported repositories.
GIT_PUSH_INDEX=

# Chromium executable for optional page rendering.
CHROMIUM_BIN=

# Set to 1 only for a local test fixture that must fetch private IP addresses.
INGEST_ALLOW_PRIVATE=

# RSS feed for optional blog backfills.
BLOG_FEED_URL=

# Comma-separated HTTPS hostnames allowed for blog articles.
BLOG_ALLOWED_HOSTS=

# Local directory for documents you upload.
LIBRARY_DIR=

# User-tier harness credential for approved seed records.
SEED_KEY=

# Inbound bearer credential for protected ingestion routes.
SEED_API_KEY=

# Optional seed-generation endpoint overriding LLM_BASE.
SEED_MODEL_BASE=

# Optional seed model overriding LLM_MODEL.
SEED_MODEL_NAME=

# Optional seed credential overriding LLM_KEY.
SEED_MODEL_KEY=

# Output token limit for seed generation.
SEED_MODEL_MAX_TOKENS=

# Sampling temperature for seed generation.
SEED_MODEL_TEMPERATURE=

# User-supplied template for generating memory drafts.
SEED_PROMPT_PATH=

# User-supplied template for generating fact drafts.
SEED_FACTS_PROMPT_PATH=

# Path to the local seed ledger.
SEED_LEDGER=

# Output directory for drafts.
SEED_OUTDIR=

# Minimum similarity for matching an emotion.
EMOTION_FLOOR=

# Path to the optional emotion vector cache.
EMOTION_CACHE=

# Set to 0 to disable configured telemetry.
MEMORY_FLEET_ENABLED=

# Outbound credential for optional fleet publishing.
MEMORY_FLEET_TELEMETRY_KEY=

# Secure WebSocket URL of your telemetry receiver.
MEMORY_FLEET_INGEST_URL=

# Node identifier for telemetry.
MEMORY_FLEET_NODE_ID=

# Source identifier override for telemetry.
MEMORY_FLEET_SOURCE_ID=

# Seconds between telemetry heartbeats.
MEMORY_FLEET_HEARTBEAT_S=

# Maximum buffered telemetry events.
MEMORY_FLEET_SPOOL_MAX=

# HTTPS endpoint used for fleet registration.
MEMORY_FLEET_MCP_URL=

# Fleet registration credential.
MCP_AGENT_KEY=

# Explicit adapter state directory when directly using the conversation reader.
OPENCLAW_STATE_DIR=

# Explicit adapter state directory when directly using the conversation reader.
HERMES_HOME=
